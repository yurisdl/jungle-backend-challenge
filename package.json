{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed Wagering Processor — Jungle Gaming backend challenge",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "bun scripts/migrate.ts up",
    "migrate:down": "bun scripts/migrate.ts down",
    "infra:up": "docker compose up -d postgres localstack",
    "infra:down": "docker compose down -v",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:properties": "bun test test/unit/wager-properties.test.ts",
    "test:resilience": "RESILIENCE_TESTS=1 bun test test/resilience",
    "test:load": "bun scripts/load-test.ts",
    "demo": "bun scripts/demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1173.0",
    "@mikro-orm/core": "6.6.19",
    "@mikro-orm/migrations": "6.6.19",
    "@mikro-orm/postgresql": "6.6.19",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.1",
    "bun-types": "1.4.5",
    "fast-check": "3.23.2",
    "typescript": "5.9.3"
  }
}
